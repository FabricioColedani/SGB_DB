# Redis Configuration

# Opción 1: Conexión local (por defecto)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Opción 2: Conexión remota con URL (descomenta si usas servicios en la nube)
# REDIS_URL=redis://:password@host:port

# Opción 3: Con autenticación (usuario y contraseña)
# REDIS_PASSWORD=tu_contraseña_aqui

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liga_basquet
DB_USER=postgres
DB_PASSWORD=postgres

# Server Configuration
PORT=3000
NODE_ENV=development
